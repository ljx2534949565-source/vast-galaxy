<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      v3.2.0 起声明 INTERNET：设置里可选「云端模型」方案，联网功能开关默认关闭。
      开关关着时应用不会发出任何请求，词库、学习记录、错题本也不会离开本机。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      v4.1.0：音乐板块自动扫描手机曲库。安卓 13 (API 33) 起读媒体库用 READ_MEDIA_AUDIO，
      以下用 READ_EXTERNAL_STORAGE（maxSdkVersion 32，避免在高版本上无谓申请）。
      只在用户点「扫描」时按需弹权限，不提前、不后台要；不读全库内容，只读媒体库索引。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!--
      v4.9.0：播放通知 / 锁屏控制。
      POST_NOTIFICATIONS 是安卓 13 (API 33) 起发通知必需的运行时权限，只在用户点播放时按需申请；
      FOREGROUND_SERVICE 与媒体专用类型（安卓 14 / API 34 起强制）用于把播放通知常驻，
      退到后台 / 锁屏后系统不会杀掉播放、通知栏和锁屏都能看到控制按钮。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!--
          v4.3.2：放开明文流量，允许接用户在自己电脑上部署的 AI 服务
          （http://192.168.x.x:端口 这类局域网地址）。云端对话由用户主动配置开关，
          默认仍未启用；关着联网时应用不发出任何请求。
        -->

        <!--
          v3.5.0：adjustResize 会把整个 WebView 压矮，所有 position:fixed 的元素
          （底栏、AI 输入条）一起被顶到键盘上方，滚动聊天时还会跟着漂移。
          改成 adjustNothing：WebView 布局视口一动不动，键盘只盖在下半屏上；
          键盘高度由 SystemBarsPlugin 读 IME inset 推给网页，网页再把输入条单独抬上去。
          注意：注释必须写在标签外，夹在属性之间会导致 manifest merger 解析失败。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:resizeableActivity="true"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          v4.9.0：音乐播放的前台服务。承载 MediaSession 与 MediaStyle 通知，
          让通知栏 / 锁屏显示正在播放并可控。foregroundServiceType 在安卓 14 起必填。
        -->
        <service
            android:name=".MusicNotificationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
