{
  "name": "kaoyan-memory",
  "version": "5.6.2",
  "private": true,
  "type": "module",
  "description": "全离线考研词汇记忆应用",
  "scripts": {
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build:h5 && cap sync android",
    "build:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug --no-daemon",
    "words:check": "node scripts/expandWords.mjs --check"
  },
  "dependencies": {
    "@capacitor/core": "6.1.2",
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-plus": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "9.9.1"
  },
  "devDependencies": {
    "@capacitor/android": "6.1.2",
    "@capacitor/cli": "6.1.2",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5030420261029002",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@vue/compiler-sfc": "3.4.21",
    "playwright": "^1.65.1",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
